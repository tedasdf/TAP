# TAP storage and remote cluster
TAP_DB_PATH=data/tap.db
TAP_M3_HOST=your-cluster-alias
TAP_M3_REPO_PATH=/remote/path/to/training-repo
TAP_GIT_REMOTE=origin
TAP_M3_SUBMIT_SCRIPT=scripts/slurm/train.slurm
TAP_M3_LOG_DIR=logs/slurm
TAP_M3_CONFIG_DIR=configs/generated
TAP_LOCAL_CONFIG_DIR=data/configs/generated
TAP_M3_CONDA_ENV=training-env

# Job lifecycle
TAP_MAX_CONCURRENT_JOBS=2
TAP_BACKGROUND_REFRESH_ENABLED=true
TAP_BACKGROUND_REFRESH_INTERVAL_SECONDS=60

# URL reachable from remote training jobs
TAP_API_URL=http://your-tap-host:8000

# Weights & Biases — never commit real values
WANDB_ENTITY=your-wandb-entity
WANDB_PROJECT=your-wandb-project
WANDB_API_KEY=
WANDB_HEALTHCHECK_RUN_ID=

# Optional notifications
DISCORD_WEBHOOK_URL=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Frontend build configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_DEV_ORIGINS=
